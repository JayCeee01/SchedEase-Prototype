SCHED_EASE_SECRET_KEY=change-me-in-production
SCHED_EASE_DEBUG=True
SCHED_EASE_ALLOWED_HOSTS=127.0.0.1,localhost
SCHED_EASE_DATABASE_URL=sqlite:///db.sqlite3
SCHED_EASE_ENV=development

# Production: inject these through the service environment, not this local file.
# Set ENV=production and DEBUG=false; replace every placeholder privately.
# SCHED_EASE_ENV=production
# SCHED_EASE_DEBUG=false
# SCHED_EASE_SECRET_KEY=<private-random-key-at-least-50-characters>
# SCHED_EASE_ALLOWED_HOSTS=<actual-public-hostname>
# SCHED_EASE_CSRF_TRUSTED_ORIGINS=
# Only true behind a sanitizing trusted proxy with a private backend:
# SCHED_EASE_TRUST_PROXY=false
# Keep zero until live HTTPS is verified, then start with 300:
# SCHED_EASE_HSTS_SECONDS=0
